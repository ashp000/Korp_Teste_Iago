# Copie este arquivo para ".env" na raiz do projeto antes de rodar `docker-compose up`.

# Chave da API da Anthropic, usada pelo EstoqueService para sugerir descrição de produtos por IA
# (endpoint POST /api/produtos/sugerir-descricao). Sem a chave, o endpoint funciona normalmente,
# mas sempre retorna a mensagem de fallback.
ANTHROPIC_API_KEY=
